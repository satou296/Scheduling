# --- 必須 ---
DATABASE_URL="file:./dev.db"
# セッションCookie署名用（openssl rand -hex 32 などで生成）
SESSION_SECRET="change-me"
# 招待リンクやOAuthのリダイレクトに使うURL
APP_URL="http://localhost:3000"

# --- Google OAuth（ログイン・カレンダー連携）---
# リダイレクトURI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- 経路検索 ---
# 未設定の場合はモック（住所文字列から決まる疑似的な所要時間）を使います
GOOGLE_ROUTES_API_KEY=""
# NAVITIME Route(totalnavi) via RapidAPI（電車・バス）
RAPIDAPI_KEY=""
RAPIDAPI_NAVITIME_HOST="navitime-route-totalnavi.p.rapidapi.com"

# --- メール（未設定の場合はコンソール出力＋/dev/mails で確認）---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="スケジュール調整 <no-reply@example.com>"
# 利用上限の80%到達などを知らせる開発者のメールアドレス
DEVELOPER_EMAIL=""

# --- ジョブ ---
# 外部cronから /api/cron を叩く場合の認証トークン
CRON_SECRET=""

# --- 開発用 ---
# true にすると Google なしでログインできる開発用ログインとモックカレンダーを有効化（本番では無効）
DEV_LOGIN="true"
