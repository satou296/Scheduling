# --- 必須 ---
DATABASE_URL="file:./dev.db"
# セッションCookie署名用。`npm run env:init` でランダムな値に置き換わる（change-me のままだとログインできない）
SESSION_SECRET="change-me"
# 招待リンクやOAuthのリダイレクトに使うURL
APP_URL="http://localhost:3000"

# --- Google OAuth（ログイン・カレンダー連携）---
# リダイレクトURI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- 運営者の情報（プライバシーポリシーと問い合わせ先に表示。本番では必須）---
# 個人名やメールアドレスはリポジトリに書かず、ここで設定する
OPERATOR_NAME=""
# 問い合わせ先。Google Cloud の OAuth 同意画面の「ユーザーサポートメール」と同じものにする
SUPPORT_EMAIL=""

# --- 経路検索 ---
# 未設定の場合はモック（住所文字列から決まる疑似的な所要時間）を使います
GOOGLE_ROUTES_API_KEY=""
# 電車・バスのプロバイダ：navitime | ekispert（未指定ならキーが設定されている方）
TRANSIT_PROVIDER=""
# NAVITIME Route(totalnavi) / Geocoding via RapidAPI（ホスト名は RapidAPI の購読画面の値）
RAPIDAPI_KEY=""
RAPIDAPI_NAVITIME_HOST="navitime-route-totalnavi.p.rapidapi.com"
RAPIDAPI_NAVITIME_GEOCODING_HOST="navitime-geocoding.p.rapidapi.com"
# 駅すぱあと API（代替）
EKISPERT_API_KEY=""

# --- メール（未設定の場合はコンソール出力＋/dev/mails で確認）---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="調整しよう <no-reply@example.com>"
# 利用上限の80%到達などを知らせる開発者のメールアドレス
DEVELOPER_EMAIL=""

# --- ジョブ ---
# 外部cronから /api/cron を叩く場合の認証トークン
CRON_SECRET=""

# --- 開発用 ---
# true にすると Google なしでログインできる開発用ログインとモックカレンダーを有効化（本番では無効）
DEV_LOGIN="true"
